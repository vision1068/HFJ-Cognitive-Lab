<Window x:Class="GoldSignalAnalyzer.Wpf.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disclaimer — Please Read"
        Height="520" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStyle="SingleBorderWindow">
    <Border Padding="20" Background="#FFFDF6E3">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding Headline}"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#FF8A1C1C"
                       Margin="0,0,0,12"/>
            <Button DockPanel.Dock="Bottom"
                    Content="I have read and understood — Continue"
                    Command="{Binding AcknowledgeCommand}"
                    Height="40" FontSize="14" FontWeight="SemiBold"
                    Margin="0,14,0,0"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding FullText}"
                           TextWrapping="Wrap"
                           FontSize="14" LineHeight="20"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
