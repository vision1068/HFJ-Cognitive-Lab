<Window x:Class="GoldSignalAnalyzer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="900" Width="980"
        WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">

        <!-- FR-35.2: persistent, always-visible 'not investment advice' banner -->
        <Border DockPanel.Dock="Top" Background="#FF8A1C1C" Padding="12,8">
            <TextBlock Text="{Binding DisclaimerBanner}"
                       Foreground="White" FontWeight="SemiBold"
                       TextWrapping="Wrap" FontSize="13"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Current signal (FR-26) -->
                <Border Grid.Row="0" BorderBrush="#FFCCCCCC" BorderThickness="1"
                        Padding="16" Margin="0,0,0,12" CornerRadius="4"
                        DataContext="{Binding Signal}">
                    <StackPanel>
                        <TextBlock Text="Current Signal" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Direction: " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Direction}" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="   Regime: " FontWeight="SemiBold" Margin="16,0,0,0"/>
                            <TextBlock Text="{Binding Regime}"/>
                            <TextBlock Text="   Data: " FontWeight="SemiBold" Margin="16,0,0,0"/>
                            <TextBlock Text="{Binding DataStatus}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding BuyScoreLabel}"/>
                        <TextBlock Text="{Binding SellScoreLabel}"/>
                        <TextBlock Text="{Binding ConfidenceLabel}"/>
                        <TextBlock Text="{Binding PrimaryReason}" TextWrapping="Wrap" Margin="0,6,0,6" FontStyle="Italic"/>
                        <TextBlock Text="Risk plan (proposed only — never executed):" FontWeight="SemiBold" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding RiskPlanSummary}" TextWrapping="Wrap"/>
                        <Expander Header="Explanation (deterministic, traceable)" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding ExplanationLines}" Margin="8,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                   FontFamily="Consolas" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Price chart (FR-27) — candles + EMA overlays, read-only drawing -->
                <Border Grid.Row="1" BorderBrush="#FFCCCCCC" BorderThickness="1"
                        Padding="16" Margin="0,0,0,12" CornerRadius="4"
                        DataContext="{Binding Chart}">
                    <StackPanel>
                        <TextBlock Text="Price Chart (candles + EMA overlays — simulated/sample data)"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding PriceRangeLabel}" FontWeight="SemiBold"/>
                            <TextBlock Text="   " />
                            <TextBlock Text="{Binding OverlayLegend}" Foreground="#FF1565C0"/>
                        </StackPanel>
                        <Border Background="#FFFAFAFA" BorderBrush="#FFDDDDDD" BorderThickness="1">
                            <Grid Width="900" Height="260">
                                <!-- candles -->
                                <ItemsControl ItemsSource="{Binding Candles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas>
                                                <Rectangle Canvas.Left="{Binding WickX}" Canvas.Top="{Binding WickTop}"
                                                           Width="1" Height="{Binding WickHeight}" Fill="#FF888888"/>
                                                <Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding BodyTop}"
                                                           Width="{Binding Width}" Height="{Binding BodyHeight}">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="#FF2E7D32"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUp}" Value="False">
                                                                    <Setter Property="Fill" Value="#FFC62828"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- EMA overlays -->
                                <ItemsControl ItemsSource="{Binding Overlays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Polyline Points="{Binding PointsString}"
                                                      Stroke="#FF1565C0" StrokeThickness="1.5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Notifications (FR-30) — passive in-app alerts, no action button -->
                <Border Grid.Row="2" BorderBrush="#FFCCCCCC" BorderThickness="1"
                        Padding="16" Margin="0,0,0,12" CornerRadius="4"
                        DataContext="{Binding Notifier}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Signal Notifications" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="   Unread: " FontWeight="SemiBold" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding UnreadCount}"/>
                        </StackPanel>
                        <TextBlock Text="No notifications yet."
                                   Foreground="#FF888888" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNotifications}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFEEEEEE" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold">
                                                <Run Text="{Binding Headline}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding Time}" Foreground="#FF888888"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontStyle="Italic"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding BuyScoreLabel}"/>
                                                <TextBlock Text="   "/>
                                                <TextBlock Text="{Binding SellScoreLabel}"/>
                                                <TextBlock Text="   "/>
                                                <TextBlock Text="{Binding ConfidenceLabel}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Paper journal (FR-26.2) — display only -->
                <Border Grid.Row="3" BorderBrush="#FFCCCCCC" BorderThickness="1"
                        Padding="16" CornerRadius="4" DataContext="{Binding Journal}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Paper-Trading Journal (simulated fills only)"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding RealisedNetPnlLabel}"
                                   FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <ListView ItemsSource="{Binding Rows}" Height="200">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Symbol" DisplayMemberBinding="{Binding Symbol}" Width="70"/>
                                    <GridViewColumn Header="Dir" DisplayMemberBinding="{Binding Direction}" Width="55"/>
                                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="65"/>
                                    <GridViewColumn Header="Entry (UTC)" DisplayMemberBinding="{Binding EntryTime}" Width="140"/>
                                    <GridViewColumn Header="Entry" DisplayMemberBinding="{Binding EntryPrice}" Width="70"/>
                                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeLots}" Width="55"/>
                                    <GridViewColumn Header="R:R" DisplayMemberBinding="{Binding RiskReward}" Width="50"/>
                                    <GridViewColumn Header="Exit (UTC)" DisplayMemberBinding="{Binding ExitTime}" Width="140"/>
                                    <GridViewColumn Header="Exit" DisplayMemberBinding="{Binding ExitPrice}" Width="70"/>
                                    <GridViewColumn Header="Net P&amp;L" DisplayMemberBinding="{Binding NetPnl}" Width="80"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
