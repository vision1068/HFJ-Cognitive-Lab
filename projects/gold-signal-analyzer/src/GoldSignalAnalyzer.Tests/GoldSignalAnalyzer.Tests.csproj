<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0-windows + UseWPF so the suite can reference the WPF Desktop composition root and
         resolve ShellViewModel (gates FR-2/QA-F4) and the MarketData provider (gate R5). This is a
         superset of arch §2.1's illustrative Tests reference list, required by the binding gates. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GoldSignalAnalyzer.Domain\GoldSignalAnalyzer.Domain.csproj" />
    <ProjectReference Include="..\GoldSignalAnalyzer.Application\GoldSignalAnalyzer.Application.csproj" />
    <ProjectReference Include="..\GoldSignalAnalyzer.Infrastructure\GoldSignalAnalyzer.Infrastructure.csproj" />
    <ProjectReference Include="..\GoldSignalAnalyzer.Persistence\GoldSignalAnalyzer.Persistence.csproj" />
    <ProjectReference Include="..\GoldSignalAnalyzer.Indicators\GoldSignalAnalyzer.Indicators.csproj" />
    <ProjectReference Include="..\GoldSignalAnalyzer.Signals\GoldSignalAnalyzer.Signals.csproj" />
    <ProjectReference Include="..\GoldSignalAnalyzer.MarketData\GoldSignalAnalyzer.MarketData.csproj" />
    <ProjectReference Include="..\GoldSignalAnalyzer.Desktop\GoldSignalAnalyzer.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="3.1.1" />
  </ItemGroup>
</Project>
