<Window x:Class="GoldSignalAnalyzer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="760" Width="960"
        WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">

        <!-- FR-35.2: persistent, always-visible 'not investment advice' banner -->
        <Border DockPanel.Dock="Top" Background="#FF8A1C1C" Padding="12,8">
            <TextBlock Text="{Binding DisclaimerBanner}"
                       Foreground="White" FontWeight="SemiBold"
                       TextWrapping="Wrap" FontSize="13"/>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Current signal (FR-26) -->
            <Border Grid.Row="0" BorderBrush="#FFCCCCCC" BorderThickness="1"
                    Padding="16" Margin="0,0,0,12" CornerRadius="4"
                    DataContext="{Binding Signal}">
                <StackPanel>
                    <TextBlock Text="Current Signal" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Direction: " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Direction}" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="   Regime: " FontWeight="SemiBold" Margin="16,0,0,0"/>
                        <TextBlock Text="{Binding Regime}"/>
                        <TextBlock Text="   Data: " FontWeight="SemiBold" Margin="16,0,0,0"/>
                        <TextBlock Text="{Binding DataStatus}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding BuyScoreLabel}"/>
                    <TextBlock Text="{Binding SellScoreLabel}"/>
                    <TextBlock Text="{Binding ConfidenceLabel}"/>
                    <TextBlock Text="{Binding PrimaryReason}" TextWrapping="Wrap" Margin="0,6,0,6" FontStyle="Italic"/>
                    <TextBlock Text="Risk plan (proposed only — never executed):" FontWeight="SemiBold" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding RiskPlanSummary}" TextWrapping="Wrap"/>
                    <Expander Header="Explanation (deterministic, traceable)" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding ExplanationLines}" Margin="8,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               FontFamily="Consolas" FontSize="12"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Paper journal (FR-26.2) — display only -->
            <Border Grid.Row="1" BorderBrush="#FFCCCCCC" BorderThickness="1"
                    Padding="16" CornerRadius="4" DataContext="{Binding Journal}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Paper-Trading Journal (simulated fills only)"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding RealisedNetPnlLabel}"
                               FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <ListView ItemsSource="{Binding Rows}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Symbol" DisplayMemberBinding="{Binding Symbol}" Width="70"/>
                                <GridViewColumn Header="Dir" DisplayMemberBinding="{Binding Direction}" Width="55"/>
                                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="65"/>
                                <GridViewColumn Header="Entry (UTC)" DisplayMemberBinding="{Binding EntryTime}" Width="140"/>
                                <GridViewColumn Header="Entry" DisplayMemberBinding="{Binding EntryPrice}" Width="70"/>
                                <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeLots}" Width="55"/>
                                <GridViewColumn Header="R:R" DisplayMemberBinding="{Binding RiskReward}" Width="50"/>
                                <GridViewColumn Header="Exit (UTC)" DisplayMemberBinding="{Binding ExitTime}" Width="140"/>
                                <GridViewColumn Header="Exit" DisplayMemberBinding="{Binding ExitPrice}" Width="70"/>
                                <GridViewColumn Header="Net P&amp;L" DisplayMemberBinding="{Binding NetPnl}" Width="80"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
