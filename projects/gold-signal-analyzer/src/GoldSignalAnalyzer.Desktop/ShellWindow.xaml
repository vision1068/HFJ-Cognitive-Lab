<Window x:Class="GoldSignalAnalyzer.Desktop.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="640" Width="1000">
    <DockPanel>
        <!-- Header: app title + honest connection/status banner -->
        <StackPanel DockPanel.Dock="Top" Margin="16,12">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusBanner}" Margin="0,4,0,0" Foreground="#8A5A00" />
        </StackPanel>

        <!-- Navigation rail across the 17 §30 screens -->
        <ListBox DockPanel.Dock="Left" Width="240" Margin="16,0,0,16"
                 ItemsSource="{Binding NavItems}" DisplayMemberPath="Title"
                 x:Name="NavList">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,4" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.InputBindings>
                <MouseBinding MouseAction="LeftClick"
                              Command="{Binding NavigateCommand}"
                              CommandParameter="{Binding SelectedItem, ElementName=NavList}" />
            </ListBox.InputBindings>
        </ListBox>

        <!-- Active screen host: rendered via the VM->View DataTemplate map -->
        <ContentControl Margin="16" Content="{Binding CurrentViewModel}" />
    </DockPanel>
</Window>
