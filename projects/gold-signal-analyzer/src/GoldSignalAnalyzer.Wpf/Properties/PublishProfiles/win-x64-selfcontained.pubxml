<?xml version="1.0" encoding="utf-8"?>
<!--
  FR-34 packaging profile — self-contained, single-file, win-x64 distributable build.

  Produces ONE self-extracting GoldSignalAnalyzer.Wpf.exe that a non-developer can run
  with NO .NET SDK / runtime installed (D6-1 self-contained, D6-2 single-file).

  Deliberately does NOT enable:
    * PublishTrimmed  — WPF/XAML + SQLitePCLRaw + System.Text.Json use reflection; trimming
                        is not trim-safe here and could break at runtime invisibly (D6-4).
    * PublishReadyToRun — needs the crossgen2 pack and only buys startup time; no AC needs it (D6-4).
    * an app.manifest requesting elevation — the app is per-user, no admin (D6-5, NFR-PKG-3).

  IncludeNativeLibrariesForSelfExtract=true is REQUIRED: WPF native components and the
  e_sqlite3 native library (C-2 journal) cannot all load in-place from a single file, so
  they are embedded and self-extracted to a per-user temp dir at runtime.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
